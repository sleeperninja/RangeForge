{
  "name": "rangeforge",
  "version": "1.0.0",
  "description": "Audio processing application with volume analysis and dynamic range tools",
  "main": "dist/electron/main.js",
  "homepage": "./",
  "author": "Your Name",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "dev:react": "cross-env ESLINT_NO_DEV_ERRORS=true react-scripts start",
    "dev:electron": "wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .",
    "build": "npm run build:react && npm run build:electron && npm run build:workers",
    "build:react": "react-scripts build",
    "build:electron": "tsc --project tsconfig.electron.json",
    "build:workers": "tsc --project tsconfig.workers.json",
    "electron": "electron .",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "pack": "npm run build && npx electron-builder --dir 2>nul || echo 'electron-builder not available, skipping pack'",
    "dist": "npm run build && npx electron-builder 2>nul || echo 'electron-builder not available, skipping dist'",
    "dist:win": "npm run build && npx electron-builder --win 2>nul || echo 'electron-builder not available, skipping dist:win'",
    "dist:mac": "npm run build && npx electron-builder --mac 2>nul || echo 'electron-builder not available, skipping dist:mac'",
    "dist:linux": "npm run build && npx electron-builder --linux 2>nul || echo 'electron-builder not available, skipping dist:linux'",
    "download:ffmpeg": "node scripts/download-ffmpeg.js",
    "setup:ffmpeg": "npm run download:ffmpeg",
    "rebuild:native": "cross-env npm_config_target_platform=win32 npm_config_target_arch=x64 npm_config_runtime=electron electron-builder install-app-deps",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "dependencies": {
    "@types/node": "^22.8.6",
    "electron-is-dev": "^2.0.0",
    "fluent-ffmpeg": "^2.1.3",
    "fs-extra": "^11.2.0",
    "mmap-io": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "web-vitals": "^3.5.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/fluent-ffmpeg": "^2.1.25",
    "@types/jest": "^29.5.12",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-rebuild": "^3.2.9",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5",
    "wait-on": "^7.2.0"
  },
  "optionalDependencies": {
    "electron-builder": "^24.13.3"
  },
  "resolutions": {
    "@babel/plugin-proposal-private-methods": "npm:@babel/plugin-transform-private-methods@^7.24.1",
    "@babel/plugin-proposal-class-properties": "npm:@babel/plugin-transform-class-properties@^7.24.1",
    "@babel/plugin-proposal-nullish-coalescing-operator": "npm:@babel/plugin-transform-nullish-coalescing-operator@^7.24.1",
    "@babel/plugin-proposal-private-property-in-object": "npm:@babel/plugin-transform-private-property-in-object@^7.24.1",
    "@humanwhocodes/config-array": "npm:@eslint/config-array@^0.18.0",
    "@humanwhocodes/object-schema": "npm:@eslint/object-schema@^2.1.4",
    "rollup-plugin-terser": "npm:@rollup/plugin-terser@^0.4.4",
    "sourcemap-codec": "npm:@jridgewell/sourcemap-codec@^1.5.0",
    "inflight": "npm:@isaacs/inflight@^1.0.6",
    "rimraf": "^5.0.5",
    "glob": "^10.3.10",
    "svgo": "^3.2.0",
    "eslint": "^8.57.0",
    "eslint-webpack-plugin": "^3.2.0",
    "typescript": "^4.9.5"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.yourcompany.rangeforge",
    "productName": "RangeForge",
    "directories": {
      "output": "release"
    },
    "files": [
      "build/**/*",
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin/",
        "to": "bin/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "beforeBuild": "npm run rebuild:native",
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}

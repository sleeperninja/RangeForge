{
  "compilerOptions": {
    "outDir": "dist/workers",
    "rootDir": ".",
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2020"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": [
    "workers/**/*",
    "electron/services/**/*"
  ],
  "exclude": ["node_modules"]
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RangeForge",
  "version": "0.1.0",
  "identifier": "app.rangeforge.desktop",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RangeForge",
        "width": 1440,
        "height": 1000,
        "minWidth": 1000,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}

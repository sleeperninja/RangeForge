{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RangeForge",
  "version": "0.6.1",
  "identifier": "app.rangeforge.desktop",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RangeForge",
        "width": 1440,
        "height": 1000,
        "minWidth": 1000,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Balance loudness, split CUE albums and write ALAC, FLAC, WAV or AAC",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
